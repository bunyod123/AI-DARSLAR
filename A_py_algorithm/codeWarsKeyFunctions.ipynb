   "source": [
    "def find_uniq(arr):\n",
    "    for word in set(arr):\n",
    "        for letter in set(word):\n",
    "            if sum([1 if letter in w else 0 for w in arr]) == 1:\n",
    "                return word\n",
    "            else: continue"
   ]
